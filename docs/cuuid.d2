# cuuid: condense and expand.
# Render: d2 --layout elk --sketch --theme 302 docs/cuuid.d2 docs/cuuid.svg
vars: { d2-config: { layout-engine: elk; theme-id: 302; sketch: true; pad: 24 } }
grid-columns: 2
horizontal-gap: 220
vertical-gap: 230

uuid: "UUID, 16 bytes\ntime · clock seq · node"
cond: "condense\ndrop the derivable node bits"
expand: "expand\nrebuild the node\nv6: splitmix64 · v1: mt19937"
wire: "wire form, about 8 bytes\ntime first, so it sorts"

uuid -> cond: serialise
cond -> wire
wire -> expand: unserialise
expand -> uuid
